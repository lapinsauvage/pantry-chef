  "dependencies": {
    "@expo/ui": "~58.0.28",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "android:native": "expo run:android",
    "ios:native": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/__tests__/*.test.ts",
    "db:sample": "cd data-pipeline && python3 -m pantry_pipeline.build_db --parquet ../data-raw/recipes.parquet --csv ../data-raw/recipes_w_search_terms.csv --out ../assets/db/recipes.db --max-recipes 2500",
    "db:full": "cd data-pipeline && python3 -m pantry_pipeline.build_db --parquet ../data-raw/recipes.parquet --csv ../data-raw/recipes_w_search_terms.csv --out ../build/recipes.db",
    "data:fetch": "bash data-pipeline/scripts/fetch_sources.sh data-raw"
  },
  "private": true
}
